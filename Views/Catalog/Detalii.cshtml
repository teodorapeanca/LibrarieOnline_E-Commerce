@model LibrarieOnline.Models.Book

@{
    ViewData["Title"] = "Detalii carte";
}

<h2>@Model.Title</h2>

<hr />

<p>
    <strong>Preț:</strong> @Model.Price lei
</p>

<h4>Descriere</h4>

<p style="white-space: pre-line;">
    @(string.IsNullOrWhiteSpace(Model.Description)
        ? "Nu există încă o descriere pentru această carte."
        : Model.Description)
</p>

<p>
    <strong>ISBN:</strong>
    @(string.IsNullOrWhiteSpace(Model.ISBN)
        ? "ISBN indisponibil"
        : Model.ISBN)
</p>

<a href="@Url.Action("Index", "Catalog")#carte-@Model.BookId"
   class="btn btn-secondary">
    Vezi în catalog
</a>
