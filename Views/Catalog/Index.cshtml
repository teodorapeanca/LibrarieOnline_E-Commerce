@model IEnumerable<LibrarieOnline.Models.Book>

@{
    ViewData["Title"] = "Catalog";
}

<style>
    /* Zona imaginilor din catalog */
    .catalog-image-container {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
        background-color: #e9ecef;
    }

    /* Fundalul estompat, realizat din aceeasi coperta */
    .catalog-image-background {
        position: absolute;
        top: -20px;
        left: -20px;
        width: calc(100% + 40px);
        height: calc(100% + 40px);
        object-fit: cover;
        object-position: center;
        filter: blur(18px) brightness(0.75);
        transform: scale(1.1);
    }

    /* Coperta principala, afisata integral */
    .catalog-image-main {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }
</style>

<h1 class="mb-4">Catalog</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-controller="Books"
           asp-action="Create"
           class="btn btn-primary mb-4">
            + Adaugă carte
        </a>
    </p>
}

<div id="inceput-catalog"></div>

<div class="row">
    @foreach (var item in Model)
    {
        var imagePath = LibrarieOnline.Services.BookImageHelper.GetImagePath(item.Title);

        <div class="col-md-4 mb-4 carte-catalog"
             id="carte-@item.BookId">

            <div class="card h-100 shadow-sm">

                <div class="catalog-image-container">

                    <img src="@imagePath"
                         class="catalog-image-background"
                         alt=""
                         aria-hidden="true" />

                    <img src="@imagePath"
                         class="catalog-image-main"
                         alt="Coperta cărții @item.Title" />

                </div>

                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        @item.Title
                    </h5>

                    <p>
                        <strong>Autor:</strong>
                        @item.Author?.Name
                    </p>

                    <p>
                        <strong>Categorie:</strong>
                        @item.Category?.Name
                    </p>

                    <p>
                        <strong>Editură:</strong>
                        @item.Publisher?.Name
                    </p>

                    <p>
                        <strong>Preț:</strong>
                        @item.Price.ToString("0.00") RON
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <div class="d-flex flex-wrap gap-2">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Books"
                               asp-action="Edit"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-controller="Books"
                               asp-action="Delete"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        }

                        <a asp-controller="Catalog"
                           asp-action="Detalii"
                           asp-route-id="@item.BookId"
                           class="btn btn-sm btn-info text-white">
                            Details
                        </a>

                        @if (User.IsInRole("User"))
                        {
                            <a asp-controller="Cos"
                               asp-action="AddToCart"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-success">
                                🛒 Adaugă în coș
                            </a>

                            <a asp-controller="Favorites"
                               asp-action="Add"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-outline-danger">
                                ❤️ Adaugă la favorite
                            </a>
                        }

                    </div>
                </div>

            </div>
        </div>
    }
</div>

<a href="#inceput-catalog"
   class="btn btn-warning inapoi-sus">
    ↑ Înapoi la începutul catalogului
</a>
