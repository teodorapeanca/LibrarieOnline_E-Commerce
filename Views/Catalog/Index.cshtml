
@model IEnumerable<LibrarieOnline.Models.Book>

@{
    ViewData["Title"] = "Catalog";
}

<h1 class="mb-4">Catalog</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-controller="Books"
           asp-action="Create"
           class="btn btn-primary mb-4">
            + Adaugă carte
        </a>
    </p>
}

<div class="row">
    @foreach (var item in Model)
    {
        var imagePath = LibrarieOnline.Services.BookImageHelper.GetImagePath(item.Title);

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                <img src="@imagePath"
                     class="card-img-top"
                     style="height:200px; object-fit:cover;"
                     alt="Coperta cărții @item.Title" />

                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        @item.Title
                    </h5>

                    <p>
                        <strong>Autor:</strong>
                        @item.Author?.Name
                    </p>

                    <p>
                        <strong>Categorie:</strong>
                        @item.Category?.Name
                    </p>

                    <p>
                        <strong>Editură:</strong>
                        @item.Publisher?.Name
                    </p>

                    <p>
                        <strong>Preț:</strong>
                        @item.Price.ToString("0.00") RON
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <div class="d-flex flex-wrap gap-2">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Books"
                               asp-action="Edit"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-controller="Books"
                               asp-action="Delete"
                               asp-route-id="@item.BookId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        }

                        <a asp-controller="Catalog"
                           asp-action="Detalii"
                           asp-route-id="@item.BookId"
                           class="btn btn-sm btn-info text-white">
                            Details
                        </a>

                       @if (User.IsInRole("User"))
{
    <a asp-controller="Cos"
       asp-action="AddToCart"
       asp-route-id="@item.BookId"
       class="btn btn-sm btn-success">
        🛒 Adaugă în coș
    </a>

    <a asp-controller="Favorites"
       asp-action="Add"
       asp-route-id="@item.BookId"
       class="btn btn-sm btn-outline-danger">
        ❤️ Adaugă la favorite
    </a>
}

                    </div>

                </div>

            </div>
        </div>
    }
</div>
