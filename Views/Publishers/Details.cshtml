
@model LibrarieOnline.Models.Publisher

@{
    ViewData["Title"] = "Cărțile editurii " + Model.Name;

    var books = ViewBag.PublisherBooks as List<LibrarieOnline.Models.Book>
                ?? new List<LibrarieOnline.Models.Book>();
}

<style>
    .catalog-image-container {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
        background-color: #e9ecef;
    }

    .catalog-image-background {
        position: absolute;
        top: -20px;
        left: -20px;
        width: calc(100% + 40px);
        height: calc(100% + 40px);
        object-fit: cover;
        object-position: center;
        filter: blur(18px) brightness(0.75);
        transform: scale(1.1);
    }

    .catalog-image-main {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }
</style>

<h1>Cărțile editurii: @Model.Name</h1>

<p>
    <strong>Țara:</strong> @Model.Country
</p>

<hr />

@if (books.Any())
{
    <div class="row">
        @foreach (var book in books)
        {
            var imagePath = LibrarieOnline.Services.BookImageHelper.GetImagePath(book.Title);

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="catalog-image-container">

                        <img src="@imagePath"
                             class="catalog-image-background"
                             alt=""
                             aria-hidden="true" />

                        <img src="@imagePath"
                             class="catalog-image-main"
                             alt="Coperta cărții @book.Title" />

                    </div>

                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            @book.Title
                        </h5>

                        <p class="card-text">
                            <strong>Preț:</strong>
                            @book.Price.ToString("0.00") lei
                        </p>

                        @if (!string.IsNullOrWhiteSpace(book.Description))
                        {
                            <p class="card-text"
                               style="white-space: pre-line;">
                                @book.Description
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(book.ISBN))
                        {
                            <p class="card-text">
                                <strong>ISBN:</strong> @book.ISBN
                            </p>
                        }

                    </div>

                    <div class="card-footer bg-white border-0">
                        <a asp-controller="Catalog"
                           asp-action="Detalii"
                           asp-route-id="@book.BookId"
                           class="btn btn-sm btn-info text-white">
                            Vezi cartea
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        Momentan nu există cărți asociate acestei edituri.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary mt-3">
    Înapoi la edituri
</a>
