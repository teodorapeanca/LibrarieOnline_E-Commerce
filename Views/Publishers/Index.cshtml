
@model IEnumerable<LibrarieOnline.Models.Publisher>

@{
    ViewData["Title"] = "Edituri";
}

<h1>Edituri</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Adaugă editură
        </a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Editură</th>
            <th>Țară</th>
            <th>Acțiuni</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Country</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-action="Details"
               asp-route-id="@item.PublisherId"
               class="btn btn-sm btn-info text-white">
                  Vezi cărțile acestei edituri
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.PublisherId"
                               class="btn btn-sm btn-warning">
                                Editează
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.PublisherId"
                               class="btn btn-sm btn-danger">
                                Șterge
                            </a>
                        }

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
