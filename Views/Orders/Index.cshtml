@model IEnumerable<LibrarieOnline.Models.Order>

@{
    var ordersWithItems = Model.Where(o => o.OrderItems.Any()).ToList();

    var grandTotal = ordersWithItems
        .SelectMany(o => o.OrderItems)
        .Sum(item => item.Quantity * item.UnitPrice);
}

<h1>Coșul meu</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@foreach (var order in ordersWithItems)
{
    <div style="border:1px solid gray; padding:10px; margin-bottom:10px;">
        <p><b>Data:</b> @order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
        <p><b>Total comandă:</b> @order.TotalAmount RON</p>

        <ul>
            @foreach (var item in order.OrderItems)
            {
                <li class="d-flex justify-content-between align-items-center mb-2">
                    <span>
                        @item.Book.Title - @item.Quantity x @item.UnitPrice
                    </span>

                    <a asp-controller="Orders"
                           asp-action="RemoveFromCart"
                           asp-route-id="@item.OrderItemId"
                           class="btn btn-sm btn-danger">
                        Șterge
                    </a>
                </li>
            }
        </ul>
    </div>
}

@if (ordersWithItems.Any())
{
    <div class="mt-4 p-3 border rounded bg-light">
        <h4>Total coș: @grandTotal.ToString("0.00") RON</h4>

        <a asp-controller="Orders"
               asp-action="Checkout"
               class="btn btn-success mt-2">
            Finalizează comanda în valoare de @grandTotal.ToString("0.00") RON
        </a>
    </div>
}
else
{
    <div class="alert alert-info">
        Coșul este gol.
    </div>
}