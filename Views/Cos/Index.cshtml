@model List<LibrarieOnline.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Coș";
    decimal total = Model.Sum(item => item.TotalPrice);
}

<h1 class="mb-4">Coș</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Coșul este gol.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Carte</th>
                <th>Preț</th>
                <th>Cantitate</th>
                <th>Total carte</th>
                <th>Acțiuni</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Book.Title</td>
                    <td>@item.Book.Price.ToString("0.00") RON</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice.ToString("0.00") RON</td>
                    <td>
                        <a asp-controller="Cos"
                               asp-action="AddToCart"
                               asp-route-id="@item.Book.BookId"
                               class="btn btn-sm btn-success">
                            +
                        </a>

                        <a asp-controller="Cos"
                               asp-action="RemoveFromCart"
                               asp-route-id="@item.Book.BookId"
                               class="btn btn-sm btn-danger">
                            -
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-3">
        Total: @total.ToString("0.00") RON
    </h4>

    <a asp-controller="Cos"
           asp-action="FinalizeazaComanda"
           class="btn btn-primary mt-3">
        Finalizează comanda de @total.ToString("0.00") RON
    </a>

    <a asp-controller="Cos"
           asp-action="Clear"
           class="btn btn-outline-danger mt-3 ms-2">
        Golește coșul
    </a>
}