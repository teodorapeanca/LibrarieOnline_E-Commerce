@model IEnumerable<LibrarieOnline.Models.Author>

@{
    ViewData["Title"] = "Autori";
}

<h1>Autori</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Adaugă autor
        </a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Nume autor</th>
            <th>Naționalitate</th>
            <th>Acțiuni</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Nationality</td>
                <td>
                    <div class="d-flex gap-2 flex-wrap">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.AuthorId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>
                        }

                        <a asp-action="Details"
                           asp-route-id="@item.AuthorId"
                           class="btn btn-sm btn-info text-white">
                            Vezi cărțile acestui autor
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@item.AuthorId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        }

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
