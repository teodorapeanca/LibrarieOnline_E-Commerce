@model LibrarieOnline.Models.Author

@{
    ViewData["Title"] = "Cărțile autorului";
}

<h1>Cărțile autorului: @Model.Name</h1>

<hr />

<p>
    <strong>Naționalitate:</strong> @Model.Nationality
</p>

<h3>Cărți scrise de acest autor</h3>

@if (Model.Books != null && Model.Books.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Titlu carte</th>
                <th>Acțiuni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>
                        <a asp-controller="Catalog"
                           asp-action="Detalii"
                           asp-route-id="@book.BookId"
                           class="btn btn-sm btn-info text-white">
                            Vezi cartea
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nu există cărți înregistrate pentru acest autor.</p>
}

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.AuthorId"
           class="btn btn-warning">
            Edit
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Înapoi la autori
    </a>
</div>
