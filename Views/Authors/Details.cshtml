
@model LibrarieOnline.Models.Author

@{
    ViewData["Title"] = "Cărțile autorului";
}

<style>
    .catalog-image-container {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
        background-color: #e9ecef;
    }

    .catalog-image-background {
        position: absolute;
        top: -20px;
        left: -20px;
        width: calc(100% + 40px);
        height: calc(100% + 40px);
        object-fit: cover;
        object-position: center;
        filter: blur(18px) brightness(0.75);
        transform: scale(1.1);
    }

    .catalog-image-main {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }
</style>

<h1>Cărțile autorului: @Model.Name</h1>

<p>
    <strong>Naționalitate:</strong> @Model.Nationality
</p>

<hr />

@if (Model.Books != null && Model.Books.Any())
{
    <div class="row">
        @foreach (var book in Model.Books)
        {
            var imagePath = LibrarieOnline.Services.BookImageHelper.GetImagePath(book.Title);

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="catalog-image-container">

                        <img src="@imagePath"
                             class="catalog-image-background"
                             alt=""
                             aria-hidden="true" />

                        <img src="@imagePath"
                             class="catalog-image-main"
                             alt="Coperta cărții @book.Title" />

                    </div>

                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            @book.Title
                        </h5>

                        <p>
                            <strong>Preț:</strong>
                            @book.Price.ToString("0.00") lei
                        </p>

                        <p style="white-space: pre-line;">
                            @(string.IsNullOrWhiteSpace(book.Description)
                                ? "Nu există încă o descriere pentru această carte."
                                : book.Description)
                        </p>

                        <p>
                            <strong>ISBN:</strong>
                            @(string.IsNullOrWhiteSpace(book.ISBN)
                                ? "ISBN indisponibil"
                                : book.ISBN)
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">
                        <a asp-controller="Catalog"
                           asp-action="Index"
                           asp-fragment="carte-@book.BookId"
                           class="btn btn-sm btn-info text-white">
                            Vezi în catalog
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <p>Nu există cărți înregistrate pentru acest autor.</p>
}

<div class="mt-3">
    <a asp-action="Index"
       class="btn btn-secondary">
        Înapoi la autori
    </a>
</div>
