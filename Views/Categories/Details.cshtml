@model LibrarieOnline.Models.Category

@{
    ViewData["Title"] = "Cărți din categoria " + Model.Name;

    var books = ViewBag.CategoryBooks as List<LibrarieOnline.Models.Book>
                ?? new List<LibrarieOnline.Models.Book>();
}

<h1>Cărți din categoria: @Model.Name</h1>
<hr />

@if (books.Any())
{
    <div class="row">
        @foreach (var book in books)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>

                        <p class="card-text">
                            <strong>Preț:</strong>
                            @book.Price.ToString("0.00") lei
                        </p>

                        @if (!string.IsNullOrWhiteSpace(book.Description))
                        {
                            <p class="card-text">
                                @book.Description
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(book.ISBN))
                        {
                            <p class="card-text">
                                <strong>ISBN:</strong> @book.ISBN
                            </p>
                        }
                    </div>

                    <div class="card-footer bg-white border-0">
                        <a asp-controller="Catalog"
                           asp-action="Detalii"
                           asp-route-id="@book.BookId"
                           class="btn btn-sm btn-info text-white">
                            Vezi cartea
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        Momentan nu există cărți în această categorie.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary mt-3">
    Înapoi la categorii
</a>
